# FinKB 配置示例。复制为 .env 后填入真实值；.env 不入库。

# ---- 百炼（OpenAI 兼容模式）----
# 工作空间专属地址形如 https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
VL_MODEL=qwen3-vl-flash
LLM_TEMPERATURE=0

# ---- 精排（百炼 qwen3-rerank）----
RERANK_MODEL=qwen3-rerank
# 留空时由 OPENAI_BASE_URL 的主机推导为 https://<host>/compatible-api/v1/reranks
RERANK_URL=

# ---- MinerU 云端解析 ----
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=xxxx
MINERU_MODEL_VERSION=vlm

# ---- 本地模型（CPU）----
BGE_M3_PATH=D:\path\to\bge-m3
BGE_DEVICE=cpu
BGE_FP16=0

# ---- Milvus ----
MILVUS_URI=http://192.168.10.150:19530
MILVUS_COLLECTION=fin_chunks

# ---- MongoDB（开启了认证，连接串必须带账号）----
MONGO_URI=mongodb://<user>:<password>@192.168.10.150:27017
MONGO_DB=finkb

# ---- MinIO ----
MINIO_ENDPOINT=192.168.10.150:9000
MINIO_ACCESS_KEY=xxxx
MINIO_SECRET_KEY=xxxx
MINIO_BUCKET=finkb-files
MINIO_SECURE=0

# ---- 本地路径（相对项目根目录）----
ARTIFACTS_DIR=data/artifacts
